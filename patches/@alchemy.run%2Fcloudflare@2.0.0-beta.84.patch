+const resolveRunner = (basename: string) => {
+  // Bun selects published src/ exports, but Node children must run the shipped
+  // lib/ entry. Source entries require a checkout-only loader omitted from npm.
+  const publishedSource =
+    moduleExtension(import.meta.url) === ".ts" &&
+    /[\\/]node_modules[\\/]/.test(fileURLToPath(import.meta.url));
+  return fileURLToPath(
+    publishedSource
+      ? new URL(`../../lib/Workers/${basename}.js`, import.meta.url)
+      : import.meta.resolve(`./${basename}${moduleExtension(import.meta.url)}`),
+  );
+};
 
