{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "50%",
  "globalDependencies": [
    ".node-version",
    "bunfig.toml",
    "tsconfig.json",
    "packages/config/**",
    "scripts/**",
    "stacks/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@pcobooster/marketing#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "env": ["POSTHOG_PROJECT_KEY"]
    },
    "@pcobooster/admin#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "ADMIN_BASE_PATH"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@pcobooster/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "PCOBOOSTER_STAGE",
        "PLANNING_CENTER_TIME_ZONE",
        "POSTHOG_PROJECT_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/stage-marketing.ts"],
      "outputs": ["dist/**", "public/marketing/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": []
    },
    "//#lint:ci": {
      "outputs": []
    },
    "//#test:root": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
