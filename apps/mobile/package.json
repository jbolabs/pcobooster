{
  "name": "@pcobooster/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "scripts": {
    "dev": "expo start --port $(bash scripts/metro-port.sh)",
    "ios": "expo run:ios",
    "native:generate": "expo prebuild --no-install --platform ios",
    "tokens": "bun run scripts/generate-tokens.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/mobile/src",
    "ios:build": "bash scripts/build-ios.sh",
    "ios:release": "bash scripts/release-ios.sh",
    "ios:release:status": "bun run scripts/release/release-cli.ts status --build",
    "ios:release:builds": "bun run scripts/release/release-cli.ts builds",
    "ios:release:latest": "bun run scripts/release/release-cli.ts latest",
    "ios:testflight": "bun run scripts/release/testflight.ts",
    "ios:hermes-gate": "bun run scripts/hermes-gate/gate.ts",
    "ios:release-smoke": "bash scripts/release-smoke.sh",
    "ios:source-maps": "bun run scripts/source-maps.ts",
    "ios:capture": "bash scripts/capture.sh",
    "ios:compare": "bash scripts/compare.sh",
    "ios:taps": "bash scripts/tap-flows.sh",
    "ios:taps:plan": "bash scripts/tap-flows.sh --suite plan --simulator pcob-expo-runsheet"
  },
  "dependencies": {
    "@expo/ui": "58.0.21",
    "@pcobooster/client": "workspace:*",
    "@pcobooster/contracts": "workspace:*",
    "@pcobooster/planning-center-models": "workspace:*",
    "@posthog/core": "1.59.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.104.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-query-persist-client": "5.104.3",
    "core-js": "3.50.0",
    "effect": "4.0.6",
    "expo": "58.0.16",
    "expo-application": "58.1.2",
    "expo-build-properties": "58.0.11",
    "expo-clipboard": "58.0.3",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.10",
    "expo-font": "58.0.9",
    "expo-glass-effect": "58.0.4",
    "expo-haptics": "58.0.7",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.13",
    "expo-print": "58.0.7",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.19",
    "expo-status-bar": "58.0.3",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-updates": "58.0.17",
    "expo-video": "58.0.12",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.21.5",
    "@pcobooster/config": "workspace:*",
    "@pcobooster/design-tokens": "workspace:*",
    "@types/react": "19.3.0",
    "posthog-react-native": "4.81.2",
    "sf-symbols-typescript": "2.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
